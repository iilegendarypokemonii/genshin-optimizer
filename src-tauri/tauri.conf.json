{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genshin Optimizer Local",
  "version": "0.2.0",
  "identifier": "com.iilegendarypokemonii.genshinoptimizerlocal",
  "build": {
    "beforeDevCommand": "node tools/scripts/desktop-dev-server.mjs",
    "devUrl": "http://127.0.0.1:4200",
    "beforeBuildCommand": "node .yarn/releases/yarn-3.4.1.cjs frontend:desktop:build",
    "frontendDist": "../dist/apps/frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Genshin Optimizer Local",
        "width": 1440,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 760,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "shortDescription": "A personal Windows desktop modification of Genshin Optimizer",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Genshin Optimizer Local"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDRUQ0QzIyOTIwMDNEOQpSV1RaQXlBcHd0VE9CZkxPbWwvSE1HaVdwSXdFRnBTZHB0WG1ST2hPUjZhOXBiQjlnU0ZNMzNaeQo=",
      "endpoints": [
        "https://github.com/iilegendarypokemonii/genshin-optimizer/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
